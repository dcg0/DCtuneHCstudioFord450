{
  "expo": {
    "name": "DC Tune HC Studio",
    "slug": "dc-tune-hc-studio",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.dctunehc.studio",
      "versionCode": 1,
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1a1a1a"
      }
    },
    "ios": {
      "bundleIdentifier": "com.dctunehc.studio",
      "buildNumber": "1",
      "supportsTabletMode": true,
      "infoPlist": {
        "NSBluetoothPeripheralUsageDescription": "La app necesita Bluetooth para conectarse al ELM327",
        "NSBluetoothCentralUsageDescription": "La app necesita Bluetooth para conectarse al ELM327",
        "NSLocationWhenInUseUsageDescription": "La app necesita ubicación para escanear dispositivos Bluetooth"
      }
    },
    "web": {
      "favicon": "./assets/icon.png",
      "display": "standalone",
      "scope": "/",
      "startUrl": "/"
    },
    "plugins": [
      "react-native-bluetooth-classic"
    ]
  }
}
